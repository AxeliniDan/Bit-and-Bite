{
    "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
    "productName": "bit-and-bite",
    "version": "0.3.2",
    "identifier": "com.bitandbite.app",
    "build": {
        "frontendDist": "../dist",
        "devUrl": "http://localhost:5173",
        "beforeDevCommand": "npm run dev",
        "beforeBuildCommand": "npm run build"
    },
    "app": {
        "windows": [
            {
                "title": "BitAndBite",
                "width": 800,
                "height": 600,
                "resizable": true,
                "fullscreen": false
            }
        ],
        "security": {
            "csp": null
        }
    },
    "bundle": {
        "active": true,
        "targets": [
            "nsis",
            "msi"
        ],
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.icns",
            "icons/icon.ico"
        ]
    },
    "plugins": {
        "updater": {
            "endpoints": [
                "https://github.com/AxeliniDan/Bit-and-Bite/releases/latest/download/latest.json"
            ],
            "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM3OUYwMTA1QzA0QkI2RDQKUldUVXRrdkFCUUdmTjBGS0JQSmtOTWRBdStUQnU2L3VSZFNQQkNSNXdzaVQvTDNjWERneHhKMjQK"
        }
    }
}